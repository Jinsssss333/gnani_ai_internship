# Prisma: use the endpoint and API key details shown in your Gnani dashboard.
PRISMA_API_URL=
PRISMA_API_KEY_ID=
PRISMA_LANGUAGE_FIELD=language_code

# Evon v3.3: point this at an inference server exposing an OpenAI-compatible
# /chat/completions endpoint. Leave blank to use the clearly labelled demo parser.
EVON_CHAT_COMPLETIONS_URL=
EVON_API_KEY=
EVON_MODEL=evon-v3.3

# Confirm the exact URL, model name, and key format in the Gnani dashboard.
TIMBRE_API_URL=https://api.gnani.ai/v1/tts/inference
TIMBRE_API_KEY=
TIMBRE_MODEL=timbre-2.5
TIMBRE_VOICE=Nalini
TIMBRE_LANGUAGE=hi-IN

DATABASE_PATH=./data/visits.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
