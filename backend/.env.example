# Gnani developer docs: short recordings use synchronous Prisma REST.
# GNANI_API_KEY_ID is shared by Prisma and Timbre; service-specific keys below override it.
GNANI_API_KEY_ID=
GNANI_STT_BASE_URL=https://api.vachana.ai
GNANI_DEFAULT_LANG=hi-IN
# Optional explicit override; otherwise the backend appends /stt/v3 to GNANI_STT_BASE_URL.
# PRISMA_API_URL=https://api.vachana.ai/stt/v3
PRISMA_API_KEY_ID=
PRISMA_FORMAT=transcribe
PRISMA_ITN_NATIVE_NUMERALS=false

# Evon v3.3: set this after starting an OpenAI-compatible inference server.
# Example: http://localhost:8000/v1/chat/completions
# The model name must match the ID/alias that server exposes.
EVON_INFERENCE_ENDPOINT=
EVON_MODEL_NAME=gnani-evon-v3.3
EVON_CHAT_COMPLETIONS_URL=
EVON_API_KEY=
EVON_MODEL=

# Timbre v2.5 REST API. Get a Gnani API key ID from the dashboard.
TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_API_KEY_ID=
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
TIMBRE_LANGUAGE=hi-IN

DATABASE_PATH=./data/visits.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
